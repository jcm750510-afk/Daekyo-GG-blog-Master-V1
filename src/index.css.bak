@import "tailwindcss";
@import url('https://cdn.jsdelivr.net/gh/orioncactus/pretendard/dist/web/static/pretendard.css');

@theme {
  --font-sans: "Pretendard", ui-sans-serif, system-ui, sans-serif;
}

@layer base {
  body {
    @apply bg-slate-50 text-slate-800;
  }
}

.markdown-body h1 { @apply text-2xl font-bold mt-6 mb-2 text-slate-900; }
.markdown-body h2 { @apply text-xl font-bold mt-5 mb-2 text-slate-800; }
.markdown-body h3 { @apply text-lg font-bold mt-4 mb-2 text-slate-800; }
.markdown-body p { @apply mb-4 leading-relaxed text-slate-600; }
.markdown-body strong { @apply text-slate-900 font-bold bg-yellow-100 px-1 rounded; }
.markdown-body ul { @apply list-disc pl-5 mb-4 space-y-1; }
.markdown-body ol { @apply list-decimal pl-5 mb-4 space-y-1; }
.markdown-body li { @apply text-slate-600; }
